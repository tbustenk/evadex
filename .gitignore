# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
